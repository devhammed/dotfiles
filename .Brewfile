tap "dunglas/frankenphp", trusted: true
tap "mongodb/brew", trusted: true
tap "oven-sh/bun", trusted: true
tap "shivammathur/extensions", trusted: true
tap "shivammathur/php", trusted: true
tap "stripe/stripe-cli", trusted: true
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Cloudflare Tunnel client (formerly Argo Tunnel)
brew "cloudflared"
# General-purpose scripting language
brew "php"
# Dependency Manager for PHP
brew "composer"
# Load/unload environment variables based on $PWD
brew "direnv"
# Command-line batch renaming tool
brew "f2"
# Play, record, convert, and stream select audio and video codecs
brew "ffmpeg"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# GNU Privacy Guard (OpenPGP)
brew "gnupg"
# Open source programming language to build simple/reliable/efficient software
brew "go"
# Modern load testing tool, using Go and JavaScript
brew "k6"
# Command-line interface to LiveKit
brew "livekit-cli"
# Web and API based SMTP testing
brew "mailpit", link: false
# Open source relational database management system
brew "mysql@8.4"
# HTTP(S) server and reverse proxy, and IMAP/POP3 proxy server
brew "nginx"
# Libraries for security-enabled client and server applications
brew "nss"
# HTTP load generator, inspired by rakyll/hey with tui animation
brew "oha"
# Development kit for the Java programming language
brew "openjdk"
# Development kit for the Java programming language
brew "openjdk@21"
# Object-relational database system
brew "postgresql@18"
# Develop and deploy code with zero configuration
brew "railway"
# Persistent key-value database, with built-in net interface
brew "redis"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Powerful, clean, object-oriented scripting language
brew "ruby"
# Safe, concurrent, practical language
brew "rust"
# Rust toolchain installer
brew "rustup"
# Cross-shell prompt for astronauts
brew "starship"
# SMTP command-line test tool
brew "swaks"
# User interface to the TELNET protocol
brew "telnet"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Internet file retriever
brew "wget"
# Yet Another Dotfiles Manager
brew "yadm"
# Shell extension to navigate your filesystem faster
brew "zoxide"
# Incredibly fast JavaScript runtime, bundler, transpiler and package manager - all in one.
brew "oven-sh/bun/bun"
# Event PHP extension
brew "shivammathur/extensions/event@8.4", trusted: true
# Event PHP extension
brew "shivammathur/extensions/event@8.5", trusted: true
# Redis PHP extension
brew "shivammathur/extensions/phpredis@8.4", trusted: true
# Redis PHP extension
brew "shivammathur/extensions/phpredis@8.5", trusted: true
# Xdebug PHP extension
brew "shivammathur/extensions/xdebug@8.4", trusted: true
# Xdebug PHP extension
brew "shivammathur/extensions/xdebug@8.5", trusted: true
# General-purpose scripting language
brew "shivammathur/php/php", trusted: true
# General-purpose scripting language
brew "shivammathur/php/php@8.4", trusted: true
# Stripe CLI utility
brew "stripe/stripe-cli/stripe"
# Voice and text chat software
cask "discord"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Collaborative team software
cask "figma"
# Web browser
cask "firefox"
# UI toolkit for building applications for mobile, web and desktop
cask "flutter"
# PHP and Web development environment manager
cask "flyenv"
# Web browser
cask "google-chrome"
# Java IDE by JetBrains
cask "intellij-idea"
# Open-source cross-platform alternative to AirDrop
cask "localsend"
# Reverse proxy, secure introspectable tunnels to localhost
cask "ngrok"
# Music streaming service
cask "spotify"
# Messaging app with a focus on speed and security
cask "telegram"
# Open-source BitTorrent client
cask "transmission"
